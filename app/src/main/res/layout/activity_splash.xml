<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Workout Background Image -->
    <ImageView
        android:id="@+id/splashWorkoutImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/splash_workout"
        android:scaleType="centerCrop"
        android:contentDescription="Workout image" />

    <!-- Dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- Purple gradient-style overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#330F001F" />

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp">

        <!-- Top spacing -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- Dumbbell Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏋️"
            android:textSize="55sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- TYNTRA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TYNTRA"
            android:textColor="@color/white"
            android:textSize="42sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:shadowColor="#7C4DFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORKOUT PLANNER"
            android:textColor="@color/primary_light"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginTop="5dp" />

        <!-- Purple line -->
        <View
            android:layout_width="70dp"
            android:layout_height="3dp"
            android:background="@color/primary"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plan. Train. Transform."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Bottom spacing -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <!-- Loading indicator -->
        <ProgressBar
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:indeterminateTint="@color/primary_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Let's get stronger 💪"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</FrameLayout>